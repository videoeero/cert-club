# Copy this file to model_config.env (already gitignored) and fill in the
# backend you actually run. Which CLI/model you use is a per-developer choice,
# same reasoning as the gitignored skill installs in skills/README.md — never
# committed, never assumed to be the same across machines.
#
# Consumed by scripts/run-authoring-batch.mjs, which loops the
# author-questions -> evaluate-questions pair across a list of domains and
# invokes whichever CLI you select here to run each step non-interactively.

# One of: claude | opencode | copilot | agy
AUTHORING_CLI=claude

# --- claude (Claude Code CLI) ---
# Leave empty to use the CLI's own default model.
AUTHORING_CLAUDE_MODEL=

# --- opencode ---
# Named agent to run under (opencode's own agent definitions, not this repo's
# skills). Leave empty to use opencode's default agent.
AUTHORING_OPENCODE_AGENT=
# Leave empty to use the agent's own configured model.
AUTHORING_OPENCODE_MODEL=

# --- copilot (GH Copilot CLI) ---
AUTHORING_COPILOT_MODEL=auto
AUTHORING_COPILOT_EFFORT=high

# --- agy (Google Antigravity CLI, e.g. Gemini 3.8 Flash) ---
# Run `agy models` to see exact IDs available on your machine.
AUTHORING_AGY_MODEL=gemini-3.8-flash-medium

# Run fully unattended: skip tool-permission/approval prompts so the batch can
# run without a human watching each step. This lets the CLI edit files and run
# shell commands with zero confirmation — leave this false unless you trust
# the batch enough to walk away from it, and always review the diff before
# committing either way.
AUTHORING_UNATTENDED=false

# Seconds to wait for a single skill invocation before giving up.
AUTHORING_TIMEOUT=900
