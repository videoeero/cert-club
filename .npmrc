# eslint-plugin-react-hooks@5.x has not published an eslint 10 peer range yet,
# and typescript-eslint's peer range still caps below TypeScript 7 (this repo
# aliases a TS 6 build in for linting only — see eslint.config.js and the
# "typescript"/"@typescript/native" devDependencies in package.json).
# Both are functionally compatible; suppress the peer-dependency conflict.
legacy-peer-deps=true
